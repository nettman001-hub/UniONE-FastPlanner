# ------------------------------------------------------------------
# AI 공급자
# ------------------------------------------------------------------
# 키를 하나도 넣지 않으면 내장 생성기(규칙 기반)로 동작합니다.
# 앱의 모든 기능은 키 없이도 그대로 쓸 수 있습니다.
#
# 우선순위: AI_PROVIDER 지정 > DEEPSEEK_API_KEY > ANTHROPIC_API_KEY > 내장 생성기
# AI_PROVIDER=deepseek        # deepseek | anthropic | local

# --- DeepSeek (기본) ---------------------------------------------
# 키 발급: https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
# 응답이 "출력 한도에서 잘렸습니다" 오류로 실패하면 이 값을 올리세요.
# 모델이 지원하는 상한을 넘기면 400 이 납니다.
DEEPSEEK_MAX_TOKENS=8192

# --- Anthropic (선택) --------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# ------------------------------------------------------------------
# 생성 작업 큐
# ------------------------------------------------------------------
# 생성은 서버 큐에서 돌므로 탭을 닫아도 끝까지 진행됩니다.
# 기본은 메모리 저장이라 서버를 재시작하면 진행 중이던 작업이 사라집니다.
# 아래 경로를 지정하면 파일로 남아 재시작에도 견딥니다. (단일 서버 배포용)
# JOB_STORE_DIR=.jobs
