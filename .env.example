# ------------------------------------------------------------------
# AI 공급자
# ------------------------------------------------------------------
# 키를 하나도 넣지 않으면 내장 생성기(규칙 기반)로 동작합니다.
# 앱의 모든 기능은 키 없이도 그대로 쓸 수 있습니다.
#
# 우선순위: AI_PROVIDER 지정 > DEEPSEEK_API_KEY > ANTHROPIC_API_KEY > 내장 생성기
# AI_PROVIDER=deepseek        # deepseek | anthropic | local

# --- DeepSeek (기본) ---------------------------------------------
# 키 발급: https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 사용자는 설정 → 만들기에서 **기본 / 고급** 둘 중 하나를 고릅니다.
# 화면에는 등급 이름만 보이고, 어떤 모델인지는 여기서만 정합니다.
#
# 둘을 같은 값으로 두면 고급을 골라도 달라지는 것이 없습니다 —
# 관리자 화면의 점검 탭이 그 경우를 붉은 글씨로 잡아 줍니다.
DEEPSEEK_MODEL_BASIC=deepseek-v4-flash
DEEPSEEK_MODEL_ADVANCED=deepseek-v4-pro

# 등급이 생기기 전에 쓰던 이름. 넣어 두면 **고급** 쪽 기본값이 됩니다.
# 위 두 줄을 쓰신다면 지우셔도 됩니다.
# DEEPSEEK_MODEL=deepseek-v4-pro

# 얼마나 깊게 생각할지. 비워 두면 max → xhigh → high 순으로 시도하고,
# 엔드포인트가 거부하면 한 칸씩 내려온 뒤 마지막에는 이 값을 빼고 부릅니다.
# 어느 단계까지 받는지는 `npm run check:ai` 가 알려 줍니다.
# 아예 끄려면 off.
# DEEPSEEK_REASONING_EFFORT=
# 한 번의 호출로 받을 **출력** 토큰 상한. 산출물별 요청 분량이 이 값에 맞춰 함께
# 조절되므로, 여기만 바꾸면 모든 생성 단계와 AI 에이전트에 반영됩니다.
#
# 응답이 "출력 한도에서 잘렸습니다" 오류로 실패하면 올리세요.
# DeepSeek 출력 상한은 앱 전체에서 384000으로 고정됩니다. 이 환경변수는 사용하지
# 않습니다. DeepSeek 운영 모델의 지원 상한(384K)을 모든 AI 생성 경로에 요청합니다.

# --- Anthropic (선택) --------------------------------------------
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# ------------------------------------------------------------------
# 생성
# ------------------------------------------------------------------
# 단계마다 지연을 넣습니다. 기본 0(꺼짐).
# 키 없이 내장 생성기로 돌리면 한 단계가 순식간에 끝나 "중단 → 이어서 만들기" 동작을
# 눈으로 확인할 수 없습니다. 시연하거나 검증할 때만 켜세요.
# GENERATE_STEP_DELAY_MS=4000

# ------------------------------------------------------------------
# 로그인 · 데이터베이스
# ------------------------------------------------------------------
# DATABASE_URL 이 없으면 PGlite(파일 기반 Postgres)로 이 컴퓨터 안에서만 돕니다.
# 로컬 개발은 그대로 두어도 됩니다 — 파일로 남아 껐다 켜도 데이터가 유지됩니다.
# 배포에는 반드시 넣어야 합니다. 서버리스는 인스턴스가 매번 새로 떠서
# 파일이 함께 사라집니다(관리자 → 점검 탭이 이 경우를 경고합니다).

# --- 데이터베이스 -------------------------------------------------
# Supabase → Connect → Direct(Connection string) → Transaction pooler (포트 6543)
# 무료 플랜의 직접 연결(5432)은 IPv6 전용이라 Vercel 에서 연결되지 않습니다.
# DATABASE_URL=postgresql://postgres.xxxx:비밀번호@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres

# 인증서까지 검증하려면 CA 인증서(PEM)를 넣습니다. 비워 두면 암호화는 하되 검증은 건너뜁니다.
# DATABASE_SSL_CA=

# 인스턴스당 연결 수. 서버리스는 인스턴스가 여러 개 뜨므로 작게 잡습니다.
# DATABASE_POOL_MAX=3

# --- 세션 ---------------------------------------------------------
# 로그인 쿠키를 서명하는 열쇠. 16자 이상. **배포에는 반드시 필요합니다.**
# 이 값이 바뀌면 모든 사용자가 로그아웃됩니다.
# 만들기(PowerShell): -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
# 만들기(맥·리눅스):  openssl rand -base64 36
AUTH_SECRET=

# --- 공용 테스트 계정 ---------------------------------------------
# 둘 다 채우면 그 계정으로 로그인할 수 있습니다 (첫 로그인 때 자동으로 만들어집니다).
# 지인에게 데모를 보여 줄 때 쓰세요. 비워 두면 그런 계정은 없습니다.
# TESTER_EMAIL=tester@uniboard.app
# TESTER_PASSWORD=
# TESTER_NAME=테스트 계정

# --- 관리자 ------------------------------------------------------
# /admin 을 볼 수 있는 계정. 쉼표로 여럿 적을 수 있습니다.
# **비워 두면 아무도 관리자가 아닙니다.** 아닌 사람은 주소로 들어와도 404 입니다.
# 표가 아니라 환경변수로 두는 이유 — 데이터베이스가 통째로 새어도
# 관리자 권한까지 새지 않게 하려는 것입니다. 자세한 것은 doc/dev/08-admin.md
# ADMIN_EMAILS=

# --- 가입 정책 ----------------------------------------------------
# 아무것도 없으면 가입이 닫힙니다 (공용 테스트 계정으로만 들어옴).
# SIGNUP_CODE 를 정하면 그 초대 코드를 아는 사람만 가입할 수 있습니다.
# SIGNUP_CODE=
# ALLOW_SIGNUP=1   # 누구나 가입 — 공개 주소에서는 권하지 않습니다

# --- 로컬 데이터베이스 파일 ---------------------------------------
# DATABASE_URL 이 없을 때 PGlite 가 데이터를 두는 폴더. 기본 .pglite
#
# 메모리가 아니라 **파일**입니다 — 껐다 켜도 데이터가 그대로 있습니다.
# 저장소 폴더 밖에 두면 git clean 을 하거나 저장소를 다시 받아도 남습니다.
# 경로 구분자는 / 로 쓰세요. \ 는 탈출 문자로 읽힐 수 있습니다.
# PGLITE_DIR=C:/dev/uniboard-data
